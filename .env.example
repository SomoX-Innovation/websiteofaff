# Firebase web config (Firebase Console → Project settings → Your apps).
# These values are public; security is enforced by firestore.rules / storage.rules.
# If unset, src/lib/firebase.js falls back to the built-in defaults.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Admin (/admin) uses Firebase Auth (Email/Password). Enable it under
# Authentication → Sign-in method, create your user, then add a document to the
# Firestore `site_admins` collection with that user's UID as the document ID.
# Add your site domain under Authentication → Settings → Authorized domains.
